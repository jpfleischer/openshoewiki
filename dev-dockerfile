FROM node:24-bookworm-slim AS node

FROM php:8.4-cli-bookworm

COPY --from=node /usr/local/ /usr/local/
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

RUN apt-get update && apt-get install -y \
	bash \
	curl \
	git \
	unzip \
	libicu-dev \
	libpq-dev \
	libzip-dev \
	&& rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-install -j"$(nproc)" \
	bcmath \
	intl \
	pdo_pgsql \
	&& docker-php-ext-install zip

WORKDIR /srv

COPY . /srv
RUN mkdir -p /srv/storage/app/public /srv/storage/framework/cache/data \
	/srv/storage/framework/sessions /srv/storage/framework/views \
	/srv/storage/logs /srv/bootstrap/cache /srv/public/images \
	&& chmod +x /srv/dev.sh \
	&& APP_ENV=local APP_DEBUG=false \
	APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= \
	/bin/bash /srv/dev.sh "SETUP"
ENTRYPOINT [ "/bin/bash", "-c", "/bin/bash /srv/dev.sh" ]
